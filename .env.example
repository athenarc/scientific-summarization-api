# Scientific Paper Summarization API Configuration
#
# Typical split deploy: this API on Ubuntu (Docker), model on another machine
# (e.g. Ollama on a Mac Studio) or a cloud OpenAI-compatible provider.

# Required Configuration
OPENAI_API_HOST=your-openai-api-host-here
OPENAI_API_KEY=your-openai-api-key-here
MODEL=your-model-name-here

# Optional AI Configuration
# Comma-separated allowlist for per-request "model" overrides (empty = any)
# ALLOWED_MODELS=deepseek-chat,llama3.1:8b,qwen2.5:14b,qwen3:30b-a3b-instruct-2507-q4_K_M
MAX_TOKENS=1000
TEMPERATURE=0.7
TOP_P=0.95
REQUEST_TIMEOUT=300

# Optional local backend (e.g. Ollama on another machine).
# Models in LOCAL_MODELS route here; default MODEL uses OPENAI_API_HOST.
# From the API host, use the Mac/Ollama machine's LAN or Tailscale IP — never 127.0.0.1.
# LOCAL_API_HOST=http://195.251.63.161
# LOCAL_API_PORT=11434
# LOCAL_API_KEY=not_needed
# LOCAL_MODELS=llama3.1:8b,qwen2.5:14b,qwen3:30b-a3b-instruct-2507-q4_K_M
# ALLOWED_MODELS=deepseek-chat,llama3.1:8b,qwen2.5:14b,qwen3:30b-a3b-instruct-2507-q4_K_M

# Application Configuration
MAX_PAPERS=50
PROMPTS_FILE=system_prompts.yaml

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Security Configuration (for production)
CORS_ORIGINS=*
ALLOWED_HOSTS=*

# --- Provider examples ---

# Cloud OpenAI-compatible provider
# OPENAI_API_HOST=https://api.deepseek.com
# OPENAI_API_KEY=sk-...
# MODEL=deepseek-chat

# Ollama on a remote machine (VPN / Tailscale / LAN / SSH tunnel)
# Use the Mac/server address reachable FROM the Ubuntu API host.
# Do not use localhost or host.docker.internal — those only reach the API machine.
# Primary cloud + local Ollama side-by-side:
# OPENAI_API_HOST=https://api.deepseek.com
# OPENAI_API_KEY=sk-...
# MODEL=deepseek-chat
# LOCAL_API_HOST=http://100.x.y.z
# LOCAL_API_PORT=11434
# LOCAL_API_KEY=not_needed
# LOCAL_MODELS=llama3.1:8b,qwen2.5:14b,qwen3:30b-a3b-instruct-2507-q4_K_M
# ALLOWED_MODELS=deepseek-chat,llama3.1:8b,qwen2.5:14b,qwen3:30b-a3b-instruct-2507-q4_K_M

# Optional Docker Compose knobs (API host)
# HOST_PORT=8000
# WORKERS=1
