# Scientific Paper Summarization API Configuration
#
# Typical split deploy: this API on Ubuntu (Docker), model on another machine
# (e.g. Ollama on a Mac Studio) or a cloud OpenAI-compatible provider.

# Required Configuration
OPENAI_API_HOST=your-openai-api-host-here
OPENAI_API_KEY=your-openai-api-key-here
MODEL=your-model-name-here

# Optional AI Configuration
MAX_TOKENS=1000
TEMPERATURE=0.7
TOP_P=0.95
REQUEST_TIMEOUT=300

# Application Configuration
MAX_PAPERS=50
PROMPTS_FILE=system_prompts.yaml

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Security Configuration (for production)
CORS_ORIGINS=*
ALLOWED_HOSTS=*

# --- Provider examples ---

# Cloud OpenAI-compatible provider
# OPENAI_API_HOST=https://api.deepseek.com
# OPENAI_API_KEY=sk-...
# MODEL=deepseek-chat

# Ollama on a remote machine (VPN / Tailscale / LAN / SSH tunnel)
# Use the Mac/server address reachable FROM the Ubuntu API host.
# Do not use localhost or host.docker.internal — those only reach the API machine.
# OPENAI_API_HOST=http://100.x.y.z
# OPENAI_API_PORT=11434
# OPENAI_API_KEY=not_needed
# MODEL=llama3.2

# Optional Docker Compose knobs (API host)
# HOST_PORT=8000
# WORKERS=1
